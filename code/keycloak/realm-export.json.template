    "authenticationFlows": [
      {
        "alias": "browser-django-oidc",
        "description": "Browser flow that redirects to django-oidc by default",
        "providerId": "basic-flow",
        "topLevel": true,
        "builtIn": false,
        "authenticationExecutions": [
          {
            "authenticator": "auth-cookie",
            "requirement": "ALTERNATIVE",
            "priority": 10,
            "authenticatorFlow": false
          },
          {
            "authenticator": "identity-provider-redirector",
            "requirement": "REQUIRED",
            "priority": 15,
            "authenticatorFlow": false,
            "authenticatorConfig": "idp-redirector-default-django-oidc"
          }
        ]
      }
    ],
    "authenticatorConfig": [
      {
        "alias": "idp-redirector-default-django-oidc",
        "config": {
