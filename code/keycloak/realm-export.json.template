          "http://localhost:8000/login/callback/",
          "http://127.0.0.1:8000/",
          "http://localhost:8000/"
        ],
        "publicClient": false,
        "secret": "django-client-secret",
        "webOrigins": [
          "http://127.0.0.1:8000",
          "http://localhost:8000"
        ]
      },
      {
        "clientId": "web",
        "enabled": true,
        "protocol": "openid-connect",
