{% extends "structure/structure_private.jinja" %}
{% from 'structure/structure.jinja' import empty_modal %}
{% block title %}Files - DI4D Portal{% endblock %}

{% block content %}
<div class="bg-white min-h-screen" x-data="{ open_upload_files: false, open_create_folder: false, open_share_item: false, open_delete_item: false, selectedItemToken: '', selectedItemName: '', selectedItemType: '' }">
    <div class="flex items-center justify-between gap-3">
        <h1 class="text-3xl lg:text-4xl font-bold text-black">Files</h1>
        {% if view_mode == 'shared' %}
            <a class="btn_primary_blue" href="{{ url('files') }}?view_mode=mine">My files</a>
        {% else %}
            <a class="btn_primary_blue" href="{{ url('files') }}?view_mode=shared">Shared with me</a>
        {% endif %}
    </div>

    {% if view_mode != 'shared' %}
        <div class="mt-4 flex flex-row gap-2">
            <button type="button" class="btn_primary_blue" @click="open_upload_files = true">
                <i class="fa-solid fa-upload mr-2"></i>Upload file
            </button>
            <button type="button" class="btn_primary_blue" @click="open_create_folder = true">
                <i class="fa-regular fa-folder mr-2"></i>Create folder
            </button>
        </div>
    {% endif %}

    <div id="files-feedback" class="mt-4">
        {% include 'components/files/feedback_htmx.jinja' %}
    </div>

    <div id="files-content" class="mt-4">
        {% include 'components/files/content_htmx.jinja' %}
    </div>

    {% call empty_modal('upload_files', 'Upload files') %}
        {% include 'components/files/upload_form_htmx.jinja' %}
    {% endcall %}

    {% call empty_modal('create_folder', 'Create folder') %}
        {% include 'components/files/create_folder_form_htmx.jinja' %}
    {% endcall %}

    {% call empty_modal('share_item', 'Shared with') %}
        {% include 'components/files/share_form_htmx.jinja' %}
    {% endcall %}

    {% call empty_modal('delete_item', 'Delete item') %}
        {% include 'components/files/delete_form_htmx.jinja' %}
    {% endcall %}
</div>
{% endblock %}
