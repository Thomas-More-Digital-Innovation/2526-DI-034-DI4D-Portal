{% extends "structure/structure_private.jinja" %}
{% from 'structure/structure.jinja' import empty_modal %}
{% block title %}Files - DI4D Portal{% endblock %}

{% block content %}
<div class="bg-white min-h-screen" x-data="{ open_upload_files: false, open_create_folder: false, open_share_item: false, open_delete_item: false, selectedItemId: null, selectedItemName: '', selectedItemType: '' }">
    <h1 class="text-3xl lg:text-4xl font-bold text-black">Files</h1>

    <div class="mt-4 flex flex-row gap-2">
        <button type="button" class="btn_primary_blue" @click="open_upload_files = true">
            <i class="fa-solid fa-upload mr-2"></i>Upload file
        </button>
        <button type="button" class="btn_primary_blue" @click="open_create_folder = true">
            <i class="fa-regular fa-folder mr-2"></i>Create folder
        </button>
    </div>

    <div id="files-feedback" class="mt-4">
        {% include 'components/files_feedback_htmx.jinja' %}
    </div>

    <form class="mt-4 flex flex-col gap-2 lg:flex-row lg:items-center" method="POST" hx-post="{{ url('files') }}" hx-target="#files-table" hx-swap="innerHTML">
        {{ csrf_input }}
        <input type="text"
               id="q"
               name="q"
               placeholder="Search..."
               value="{{ search_query }}"
               class="bg-[--white_grey] rounded-md w-full lg:max-w-md px-4 py-2"
               hx-trigger="keyup changed delay:300ms"
               hx-sync="closest form:abort">

        <select name="file_type"
                class="bg-[--white_grey] rounded-md px-4 py-2 lg:w-40"
                hx-trigger="change"
                hx-post="{{ url('files') }}"
                hx-target="#files-table"
                hx-sync="closest form:abort">
            <option value="all" {% if file_type == 'all' %}selected{% endif %}>All</option>
            <option value="pptx" {% if file_type == 'pptx' %}selected{% endif %}>PPTX</option>
            <option value="txt" {% if file_type == 'txt' %}selected{% endif %}>TXT</option>
            <option value="folder" {% if file_type == 'folder' %}selected{% endif %}>Folder</option>
        </select>
    </form>

    <div id="files-table" class="mt-4">
        {% include 'components/files_table_htmx.jinja' %}
    </div>

    {% call empty_modal('upload_files', 'Upload files') %}
        {% include 'components/files_upload_form_htmx.jinja' %}
    {% endcall %}

    {% call empty_modal('create_folder', 'Create folder') %}
        {% include 'components/files_create_folder_form_htmx.jinja' %}
    {% endcall %}

    {% call empty_modal('share_item', 'Shared with') %}
        {% include 'components/files_share_form_htmx.jinja' %}
    {% endcall %}

    {% call empty_modal('delete_item', 'Delete item') %}
        {% include 'components/files_delete_form_htmx.jinja' %}
    {% endcall %}
</div>
{% endblock %}
