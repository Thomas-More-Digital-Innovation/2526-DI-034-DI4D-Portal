{% extends "structure/structure_private.jinja"%}
{% from 'structure/structure.jinja' import empty_modal, delete_confirm_modal %}
{% block title %}Tech Talks - DI4D Portal{% endblock %}

{% block content %}
<div class="bg-white min-h-screen" x-data="{ currentDeleteId: null, currentDeleteName: null, open_add_talk: false, open_edit_talk: false, currentEditId: null, title: '', speaker: '', description: '', date: '', thubnail_filename: '', video_filename: '', isPublic: false, edit_thumbnail_filename: '', edit_video_filename: '' }">
    <div class="flex flex-col gap-4">
        <div class="flex flex-col gap-4">
            <h1 class="text-3xl lg:text-4xl font-bold text-black">Tech Talks</h1>
            <form class="flex flex-row max-w-xl gap-4" method="POST" hx-post="{{ url('tech_talks') }}" hx-target="#techtalks-grid">
            {{ csrf_input }}
            <div class="relative flex-1">
                <input type="text" 
                        id="q" 
                        name="q"
                        placeholder="Search Tech Talks" 
                        value="{{ search_query }}"
                        class="bg-[--white_grey] rounded-md w-full px-4 py-2 pr-12"
                        hx-trigger="keyup changed delay:300ms" hx-sync="closest form:abort">
                <button class="absolute right-0 top-0 bottom-0 px-3 text-[var(--light_gray)]" type="submit">        
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
            </div>
            {% if request.user.role_is_admin() %}
                <button type="button" class="px-4 bg-[--white_grey] rounded-md" @click="open_add_talk = true; title = ''; speaker = ''; description = ''; date = ''; thubnail_filename = ''; video_filename = ''; isPublic = false">
                    <i class="fa-solid fa-plus text-[--green]"></i>
                </button>
            {% endif %}
        </form>
        <div class="mt-2" id="techtalks-grid">
            {% include 'components/techtalks_htmx.jinja' %}
        </div>
        </div>

    {{ delete_confirm_modal("Delete Tech Talk", csrf_token) }}

    {% call empty_modal('add_talk', 'Add Tech Talk') %}
        <form method="post" enctype="multipart/form-data" class="flex flex-col gap-3">
            <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}"/>
            <input type="hidden" name="action" value="create"/>
            <label class="text-white" for="add_title">Title</label>
            <input id="add_title" name="title" type="text" class="w-full text-[var(--input_text)] bg-[var(--input_bg_color)] rounded-lg px-4 py-1" required x-model="title"/>
            <label class="text-white" for="add_speaker">Speaker</label>
            <input id="add_speaker" name="speaker" type="text" class="w-full text-[var(--input_text)] bg-[var(--input_bg_color)] rounded-lg px-4 py-1" required x-model="speaker"/>
            <label class="text-white" for="add_date">Date</label>
            <input id="add_date" name="date" type="date" class="w-full text-[var(--input_text)] bg-[var(--input_bg_color)] rounded-lg px-4 py-1" required x-model="date"/>
            <label class="text-white" for="add_thumbnail">Thumbnail</label>
            <div class="bg-[var(--input_bg_color)] rounded-lg px-4 py-4 border-2 border-dashed border-[var(--input_text)] flex flex-col items-center justify-center gap-2 cursor-pointer hover:opacity-80 transition relative">
                <input id="add_thumbnail" name="thubnail" type="file" class="opacity-0 w-full h-full absolute inset-0" accept="image/*" x-ref="fileInput" @change="const f = $event.target.files[0]; if(f){ thubnail_filename = f.name; }" required/>
                <div class="flex flex-col items-center justify-center gap-2 pointer-events-none">
                    <!-- Upload View -->
                    <div x-show="!thubnail_filename" class="flex flex-col items-center justify-center gap-2 text-center">
                        <i class="fa-solid fa-cloud-arrow-up text-2xl text-[var(--input_text)]"></i>
                        <span class="text-[var(--input_text)] font-semibold">Click to upload picture</span>
                    </div>
                    <!-- Preview View -->
                    <div x-show="thubnail_filename" class="flex flex-col items-center justify-center gap-2 w-full">
                        <i class="fa-solid fa-check-circle text-2xl text-green-500"></i>
                        <p class="text-sm text-[var(--input_text)] truncate max-w-full" x-text="thubnail_filename"></p>
                        <button type="button" @click.stop="thubnail_filename = ''; $refs.fileInput.value = ''" class="text-xs text-[--orange_di4d] hover:underline pointer-events-auto">Change</button>
                    </div>
                </div>
            </div>
            <label class="text-white" for="add_video">Video (accepts: mp4, webm, ogg)</label>
            <div class="bg-[var(--input_bg_color)] rounded-lg px-4 py-4 border-2 border-dashed border-[var(--input_text)] flex flex-col items-center justify-center gap-2 cursor-pointer hover:opacity-80 transition relative">
                <input id="add_video" name="videoPath" type="file" class="opacity-0 w-full h-full absolute inset-0" accept="video/mp4,video/webm,video/ogg" required x-ref="addVideoInput" @change="const f = $event.target.files[0]; if(f){ video_filename = f.name; }" />
                <div class="flex flex-col items-center justify-center gap-2 pointer-events-none">
                    <!-- Upload View -->
                    <div x-show="!video_filename" class="flex flex-col items-center justify-center gap-2 text-center">
                        <i class="fa-solid fa-cloud-arrow-up text-2xl text-[var(--input_text)]"></i>
                        <span class="text-[var(--input_text)] font-semibold">Click to upload video</span>
                    </div>
                    <!-- Preview View -->
                    <div x-show="video_filename" class="flex flex-col items-center justify-center gap-2 w-full">
                        <i class="fa-solid fa-check-circle text-2xl text-green-500"></i>
                        <p class="text-sm text-[var(--input_text)] truncate max-w-full" x-text="video_filename"></p>
                        <button type="button" @click.stop="video_filename = ''; $refs.addVideoInput.value = ''" class="text-xs text-[--orange_di4d] hover:underline pointer-events-auto">Change</button>
                    </div>
                </div>
            </div>
            <label class="text-white" for="add_description">Description</label>
            <textarea id="add_description" name="description" rows="3" class="w-full text-[var(--input_text)] bg-[var(--input_bg_color)] rounded-lg px-4 py-1" required x-model="description"></textarea>
            <label class="text-white flex items-center gap-2">
                <input type="checkbox" name="isPublic" x-model="isPublic"/>
                Public
            </label>
            <div class="flex gap-2 mt-2">
                <button type="button" class="btn text-[--button_text_modal] bg-[--white_grey] flex-1" @click="open_add_talk = false">Cancel</button>
                <button type="submit" class="btn flex-1 text-white bg-[--green]">Create</button>
            </div>
        </form>
    {% endcall %}

    {% call empty_modal('edit_talk', 'Edit Tech Talk') %}
        <form method="post" enctype="multipart/form-data" class="flex flex-col gap-3">
            <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}"/>
            <input type="hidden" name="action" value="edit"/>
            <input type="hidden" name="talk_id" x-bind:value="currentEditId"/>
            <label class="text-white" for="edit_title">Title</label>
            <input id="edit_title" name="title" type="text" class="w-full text-[var(--input_text)] bg-[var(--input_bg_color)] rounded-lg px-4 py-1" required x-model="title"/>
            <label class="text-white" for="edit_speaker">Speaker</label>
            <input id="edit_speaker" name="speaker" type="text" class="w-full text-[var(--input_text)] bg-[var(--input_bg_color)] rounded-lg px-4 py-1" required x-model="speaker"/>
            <label class="text-white" for="edit_date">Date</label>
            <input id="edit_date" name="date" type="date" class="w-full text-[var(--input_text)] bg-[var(--input_bg_color)] rounded-lg px-4 py-1" required x-model="date"/>
            <label class="text-white" for="edit_thumbnail">Thumbnail (leave empty to keep current)</label>
            <div class="bg-[var(--input_bg_color)] rounded-lg px-4 py-4 border-2 border-dashed border-[var(--input_text)] flex flex-col items-center justify-center gap-2 cursor-pointer hover:opacity-80 transition relative">
                <input id="edit_thumbnail" name="thubnail" type="file" class="opacity-0 w-full h-full absolute inset-0" accept="image/*" x-ref="editFileInput" @change="const f = $event.target.files[0]; if(f){ edit_thumbnail_filename = f.name; }"/>
                <div class="flex flex-col items-center justify-center gap-2 pointer-events-none">
                    <!-- Upload View -->
                    <div x-show="!edit_thumbnail_filename" class="flex flex-col items-center justify-center gap-2 text-center">
                        <i class="fa-solid fa-cloud-arrow-up text-2xl text-[var(--input_text)]"></i>
                        <span class="text-[var(--input_text)] font-semibold">Click to upload picture</span>
                    </div>
                    <!-- Preview View -->
                    <div x-show="edit_thumbnail_filename" class="flex flex-col items-center justify-center gap-2 w-full">
                        <i class="fa-solid fa-check-circle text-2xl text-green-500"></i>
                        <p class="text-sm text-[var(--input_text)] truncate max-w-full" x-text="edit_thumbnail_filename"></p>
                        <button type="button" @click.stop="edit_thumbnail_filename = ''; $refs.editFileInput.value = ''" class="text-xs text-[--orange_di4d] hover:underline pointer-events-auto">Change</button>
                    </div>
                </div>
            </div>
            <label class="text-white" for="edit_video">Video (leave empty to keep current)</label>
            <div class="bg-[var(--input_bg_color)] rounded-lg px-4 py-4 border-2 border-dashed border-[var(--input_text)] flex flex-col items-center justify-center gap-2 cursor-pointer hover:opacity-80 transition relative">
                <input id="edit_video" name="videoPath" type="file" class="opacity-0 w-full h-full absolute inset-0" accept="video/mp4,video/webm,video/ogg" x-ref="editVideoInput" @change="const f = $event.target.files[0]; if(f){ edit_video_filename = f.name; }" />
                <div class="flex flex-col items-center justify-center gap-2 pointer-events-none">
                    <!-- Upload View -->
                    <div x-show="!edit_video_filename" class="flex flex-col items-center justify-center gap-2 text-center">
                        <i class="fa-solid fa-cloud-arrow-up text-2xl text-[var(--input_text)]"></i>
                        <span class="text-[var(--input_text)] font-semibold">Click to upload video</span>
                    </div>
                    <!-- Preview View -->
                    <div x-show="edit_video_filename" class="flex flex-col items-center justify-center gap-2 w-full">
                        <i class="fa-solid fa-check-circle text-2xl text-green-500"></i>
                        <p class="text-sm text-[var(--input_text)] truncate max-w-full" x-text="edit_video_filename"></p>
                        <button type="button" @click.stop="edit_video_filename = ''; $refs.editVideoInput.value = ''" class="text-xs text-[--orange_di4d] hover:underline pointer-events-auto">Change</button>
                    </div>
                </div>
            </div>
            <label class="text-white" for="edit_description">Description</label>
            <textarea id="edit_description" name="description" rows="3" class="w-full text-[var(--input_text)] bg-[var(--input_bg_color)] rounded-lg px-4 py-1" required x-model="description"></textarea>
            <label class="text-white flex items-center gap-2">
                <input type="checkbox" name="isPublic" x-model="isPublic"/>
                Public
            </label>
            <div class="flex gap-2 mt-2">
                <button type="button" class="btn text-[--button_text_modal] bg-[--white_grey] flex-1" @click="open_edit_talk = false">Cancel</button>
                <button type="submit" class="btn flex-1 text-white bg-[--green]">Save</button>
            </div>
        </form>
    {% endcall %}
</div>
{% endblock %}
