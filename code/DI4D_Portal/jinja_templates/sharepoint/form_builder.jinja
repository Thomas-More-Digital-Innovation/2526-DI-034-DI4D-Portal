{% extends "structure/structure_private.jinja"%}
{% block title %}{% if form %}Edit Form{% else %}Add Form{% endif %} - DI4D Portal{% endblock %}

{% block content %}
<div class="bg-white min-h-screen" x-data="{ confirmDeleteQuestion: null, currentQuestionId: {{ questions[0].id if questions else 'null' }} }">
        <div class="mb-4">
        <a href="{{ url('forms') }}" class="text-[var(--blue_di4d)] hover:underline mb-2 inline-block">
            <i class="fa-solid fa-arrow-left mr-2"></i>Back to Forms
        </a>
        <h1 class="text-3xl lg:text-4xl font-bold text-black">{% if form %}Edit Form{% else %}Add Form{% endif %}</h1>
        {% if form_error %}
        <div class="mt-3 p-3 rounded-md bg-[--red] text-white text-sm">
            {{ form_error }}
        </div>
        {% endif %}
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {# Left side - Form settings and current question #}
        <div class="lg:col-span-2 space-y-6">
            {# Form settings #}
            <div class="bg-[var(--white_grey)] rounded-lg p-4">
                <h2 class="text-black font-semibold mb-4">Form Settings</h2>
                <form method="post" id="settings-form">
                    <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}"/>
                    <input type="hidden" name="action" value="update_settings"/>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="text-black font-semibold" for="title">Title</label>
                            <input id="title" name="title" type="text" value="{{ form.title if form else '' }}" 
                                   class="w-full bg-white rounded-md px-3 py-2 border border-gray-300" required/>
                        </div>
                        <div class="flex items-center gap-3 mt-6 md:mt-0">
                            <label class="text-black font-semibold">Active</label>
                            <input type="checkbox" name="isActive" {% if form and form.isActive %}checked{% elif not form %}checked{% endif %}/>
                        </div>
                        <div>
                            <label class="text-black font-semibold" for="startDate">Start date</label>
                            <input id="startDate" name="startDate" type="date" value="{{ form.startDate if form else '' }}" 
                                   class="w-full bg-white rounded-md px-3 py-2 border border-gray-300" required/>
                        </div>
                        <div>
                            <label class="text-black font-semibold" for="endDate">End date</label>
                            <input id="endDate" name="endDate" type="date" value="{{ form.endDate if form else '' }}" 
                                   class="w-full bg-white rounded-md px-3 py-2 border border-gray-300" required/>
                        </div>
                    </div>
                    <div class="mt-4">
                        <button type="submit" class="btn text-white bg-[--green] px-6">Save Settings</button>
                    </div>
                </form>
            </div>

            {# Current question display #}
            {% if form %}
            <div class="bg-[var(--white_grey)] rounded-lg p-4">
                <h2 class="text-black font-semibold mb-4">Question Editor</h2>
                <div id="question-editor">
                    {% if questions %}
                        {% include 'components/question_editor_htmx.jinja' %}
                    {% else %}
                        <p class="text-gray-500 text-sm">No questions yet. Click "Add Question" in the sidebar to add one.</p>
                    {% endif %}
                </div>
            </div>
            {% else %}
            <div class="bg-[var(--white_grey)] rounded-lg p-4">
                <p class="text-gray-600">Save the form settings first to add questions.</p>
            </div>
            {% endif %}
        </div>

        {# Right side - Questions list navigation #}
        <div class="bg-[var(--white_grey)] rounded-lg p-4 h-fit max-h-[calc(100vh-200px)] flex flex-col">
            <h2 class="text-black font-semibold mb-4">Questions</h2>
            {% if form %}
            <div id="questions-list" class="flex-1 overflow-y-auto space-y-2 mb-4 max-h-96">
                {% include 'components/questions_list_htmx.jinja' %}
            </div>
            <form hx-post="{{ url('form_builder_add_question', kwargs={'form_id': form.id}) }}" 
                  hx-target="#questions-list" 
                  hx-swap="innerHTML">
                <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}"/>
                <button type="submit" class="w-full btn text-white bg-[--green]">
                    <i class="fa-solid fa-plus mr-2"></i>Add Question
                </button>
            </form>
            {% else %}
            <p class="text-gray-500 text-sm">Save form settings first.</p>
            {% endif %}
            <div class="mt-4 pt-4 border-t border-gray-300 flex gap-2">
                <a href="{{ url('forms') }}" class="btn text-[--button_text_modal] bg-white flex-1 text-center">Cancel</a>
                {% if form %}
                <a href="{{ url('forms') }}" class="btn flex-1 text-white bg-[--green] text-center">Done</a>
                {% endif %}
            </div>
        </div>
    </div>

    {# Delete question confirmation modal #}
    <div x-show="confirmDeleteQuestion !== null" 
         x-cloak
         style="display:none" 
         class="fixed inset-0 z-50 flex items-center justify-center bg-black/75 p-4"
         @click="confirmDeleteQuestion = null">
        <div @click.stop class="bg-[--light_grey] rounded-xl p-4 max-w-lg w-full">
            <h2 class="text-2xl font-bold text-white mb-4">Delete Question</h2>
            <p class="text-white">Are you sure you want to delete this question? This action is irreversible.</p>
            <div class="w-full flex flex-row gap-2 mt-4">
                <button @click="confirmDeleteQuestion = null" class="btn text-[--button_text_modal] flex-1 bg-[--white_grey]">Cancel</button>
                <form method="post" class="flex-1 flex" 
                      hx-post="{{ url('form_builder_delete_question', kwargs={'form_id': form.id}) if form else '#' }}" 
                      hx-target="#questions-list" 
                      hx-swap="innerHTML"
                      @htmx:after-request="confirmDeleteQuestion = null; currentQuestionId = null">
                    <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}"/>
                    <input type="hidden" name="question_id" x-bind:value="confirmDeleteQuestion"/>
                    <button type="submit" class="btn flex-1 text-white bg-[--red]">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
