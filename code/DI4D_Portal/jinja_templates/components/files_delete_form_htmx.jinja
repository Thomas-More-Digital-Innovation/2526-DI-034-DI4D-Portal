<form class="flex flex-col gap-3"
      hx-post="{{ url('files_action', kwargs={'action': 'delete'}) }}"
      hx-target="#files-feedback"
      hx-swap="innerHTML"
      hx-on::after-request="open_delete_item = false">
    {{ csrf_input }}

    <input type="hidden" name="item_id" x-bind:value="selectedItemId">
    <input type="hidden" name="item_name" x-bind:value="selectedItemName">
    <input type="hidden" name="item_type" x-bind:value="selectedItemType">

    <p class="text-white">Do you want to delete this <span x-text="selectedItemType"></span>?</p>

    <div class="flex gap-2 mt-2">
        <button type="button" class="btn text-[--button_text_modal] bg-[--white_grey] flex-1" @click="open_delete_item = false">Cancel</button>
        <button type="submit" class="btn flex-1 text-white bg-[--red]">Delete</button>
    </div>
</form>
