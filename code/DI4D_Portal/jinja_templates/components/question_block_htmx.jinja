{# Single question block HTMX component #}
{% set datatype_name = question.datatype.name|lower if question.datatype else '' %}
{% set is_choice = datatype_name in ['multiple_choice', 'singular_choice'] %}
{% set options = question.content.split(',') if question.content else [] %}

<div class="bg-[var(--white_grey)] text-black rounded-lg p-4" id="question-block-{{ question.id }}">
    <div class="flex justify-between items-center mb-3">
        <h3 class="font-semibold">Question {{ loop.index if loop is defined else '' }}</h3>
        <button type="button" class="text-black hover:text-red-600" 
                @click="confirmDeleteQuestion = {{ question.id }}">
            <i class="fa-solid fa-trash"></i>
        </button>
    </div>
    
    <form hx-post="{{ url('form_builder_update_question', kwargs={'form_id': form.id, 'question_id': question.id}) }}" 
          hx-trigger="change delay:500ms"
          hx-swap="none">
        <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}"/>
        
        <div class="mb-3">
            <label class="text-black text-sm" for="question_text_{{ question.id }}">Question</label>
            <input id="question_text_{{ question.id }}" 
                   name="question_text" 
                   type="text" 
                   value="{{ question.question or '' }}" 
                   class="w-full bg-white text-black rounded-md px-3 py-2" 
                   required/>
        </div>

        <div class="mb-3">
            <label class="text-black text-sm" for="datatype_id_{{ question.id }}">Answer type</label>
            <select id="datatype_id_{{ question.id }}" 
                    name="datatype_id" 
                    class="w-full bg-white text-black rounded-md px-3 py-2"
                    hx-post="{{ url('form_builder_update_question', kwargs={'form_id': form.id, 'question_id': question.id}) }}"
                    hx-trigger="change"
                    hx-target="#question-block-{{ question.id }}"
                    hx-swap="outerHTML"
                    hx-include="closest form">
                {% for dtype in data_types %}
                    <option value="{{ dtype.id }}" {% if question.datatype and dtype.id == question.datatype.id %}selected{% endif %}>{{ dtype.name }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="mb-3">
            <label class="text-black text-sm" for="is_mandatory_{{ question.id }}">Required?</label>
            <select id="is_mandatory_{{ question.id }}" 
                    name="is_mandatory" 
                    class="w-full bg-white text-black rounded-md px-3 py-2">
                <option value="yes" {% if question.isMandatory %}selected{% endif %}>Yes</option>
                <option value="no" {% if not question.isMandatory %}selected{% endif %}>No</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="text-black text-sm" for="explanation_{{ question.id }}">Explanation (optional)</label>
            <textarea id="explanation_{{ question.id }}" 
                      name="explanation" 
                      class="w-full bg-white text-black rounded-md px-3 py-2" 
                      rows="2">{{ question.explanation or '' }}</textarea>
        </div>
    </form>

    {# Options section for choice types #}
    {% if is_choice %}
    <div class="mt-4 border-t border-gray-200 pt-4">
        <div class="flex items-center justify-between mb-2">
            <label class="text-black text-sm font-semibold">Options</label>
            <form hx-post="{{ url('form_builder_add_option', kwargs={'form_id': form.id, 'question_id': question.id}) }}" 
                  hx-target="#options-list-{{ question.id }}" 
                  hx-swap="innerHTML">
                <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}"/>
                <button type="submit" class="text-black hover:text-green-700 text-sm">
                    <i class="fa-solid fa-plus"></i> Add Option
                </button>
            </form>
        </div>
        <div id="options-list-{{ question.id }}" class="space-y-2">
            {% include 'components/question_options_htmx.jinja' %}
        </div>
    </div>
    {% endif %}
</div>

{# Out-of-band swap for questions overview (when questions list is available) #}
{% if questions %}
<div id="questions-overview" hx-swap-oob="innerHTML">
    {% for q in questions %}
        <div class="bg-white rounded-md px-3 py-2 text-gray-600 truncate">
            {{ loop.index }}. {{ q.question or 'Untitled question' }}
        </div>
    {% endfor %}
</div>
{% endif %}