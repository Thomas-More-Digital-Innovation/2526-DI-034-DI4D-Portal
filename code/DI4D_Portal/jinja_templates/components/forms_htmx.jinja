{# Forms HTMX Component - Form Cards Grid #}
{% if all_forms|length == 0 %}
    <div class="text-center py-12">
        <p class="text-gray-500 text-lg">No forms available at the moment.</p>
    </div>
{% else %}
    {# Two-column grid for form cards #}
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-6">
        {% for form_data in all_forms %}
            {% set form = form_data.form %}
            {% set status = form_data.status %}
            {% set deadline_passed = form_data.deadline_passed %}
            <div class="bg-[var(--white_grey)] rounded-lg p-4 flex flex-col gap-3">
                <div class="flex items-center justify-between gap-4">
                    <div class="flex-1 min-w-0">
                        <p class="text-black font-medium truncate">
                            {{ form.title }}
                            {% if form.endDate and not deadline_passed %}
                                <span class="text-gray-500 text-sm font-normal">(Deadline: {{ form.endDate.strftime('%m/%d/%Y') }})</span>
                            {% elif deadline_passed %}
                                <span class="text-red-500 text-sm font-normal">(Deadline passed)</span>
                            {% endif %}
                        </p>
                    </div>
                    {# Action button for SharePoint users #}
                    <div class="flex-shrink-0">
                        {% if deadline_passed %}
                            <span class="inline-flex items-center justify-center px-4 py-2 bg-gray-400 text-white rounded-lg text-sm font-medium cursor-not-allowed whitespace-nowrap">
                                Closed
                            </span>
                        {% elif status == 'completed' %}
                            <span class="inline-flex items-center justify-center px-4 py-2 bg-[var(--green)] text-white rounded-lg text-sm font-medium whitespace-nowrap">
                                Completed
                            </span>
                        {% elif status == 'in_progress' %}
                            <a href="{{ url('form_detail', kwargs={'form_id': form.id}) }}" 
                               class="inline-flex items-center justify-center px-4 py-2 bg-[var(--orange_di4d)] text-white rounded-lg text-sm font-medium hover:opacity-90 transition whitespace-nowrap">
                                Continue
                            </a>
                        {% else %}
                            <a href="{{ url('form_detail', kwargs={'form_id': form.id}) }}" 
                               class="inline-flex items-center justify-center px-4 py-2 bg-[var(--green)] text-white rounded-lg text-sm font-medium hover:opacity-90 transition whitespace-nowrap">
                                Start
                            </a>
                        {% endif %}
                    </div>
                </div>
                
                {#Admin#}
                {% if request.user.role_is_admin() %}
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 w-full">
                    <a href="{{ url('form_builder', kwargs={'form_id': form.id}) }}" 
                       class="w-full h-9 inline-flex items-center justify-center px-3 py-1.5 bg-[--blue_di4d] text-white rounded-md text-sm">
                        <i class="fa-solid fa-pen mr-1"></i> Edit
                    </a>
                    <button type="button" class="w-full h-9 inline-flex items-center justify-center px-3 py-1.5 bg-[--red] text-white rounded-md text-sm"
                        @click="currentDeleteId = {{ form.id }}; currentDeleteName = '{{ form.title|replace("'", "\\'") }}'">
                        <i class="fa-solid fa-trash"></i> Delete
                    </button>
                    <a href="{{ url('form_submissions', kwargs={'form_id': form.id}) }}"
                       class="w-full h-9 inline-flex items-center justify-center px-3 py-1.5 bg-[--orange_di4d] text-white rounded-md text-sm text-center whitespace-nowrap">
                        <i class="fa-solid fa-eye"></i> View submissions
                    </a>
                </div>
                {% endif %}
            </div>
        {% endfor %}
    </div>

    {# Pagination #}
    {% if all_forms.has_other_pages %}
    <div class="flex items-center justify-center gap-4 mt-6">
        <div class="flex items-center gap-2">
            {% if all_forms.has_previous and all_forms.number -1 > 0 %}
                <a href="?page={{ all_forms.previous_page_number }}{% if search_query %}&q={{ search_query }}{% endif %}{% if filter_status %}&filter_status={{ filter_status }}{% endif %}" 
                   class="px-3 py-1 bg-[var(--white_grey)] rounded-md hover:bg-gray-200 transition">
                    <i class="fa-solid fa-chevron-left"></i>
                </a>
            {% else %}
                <span class="px-3 py-1 bg-[var(--white_grey)] rounded-md text-gray-400">
                    <i class="fa-solid fa-chevron-left"></i>
                </span>
            {% endif %}
            
            <span class="text-gray-600 text-sm">{{ all_forms.number }}</span>
            
            {% if all_forms.has_next and all_forms.number + 1 <= all_forms.paginator.num_pages %}
                <a href="?page={{ all_forms.next_page_number }}{% if search_query %}&q={{ search_query }}{% endif %}{% if filter_status %}&filter_status={{ filter_status }}{% endif %}" 
                   class="px-3 py-1 bg-[var(--white_grey)] rounded-md hover:bg-gray-200 transition">
                    <i class="fa-solid fa-chevron-right"></i>
                </a>
            {% else %}
                <span class="px-3 py-1 bg-[var(--white_grey)] rounded-md text-gray-400">
                    <i class="fa-solid fa-chevron-right"></i>
                </span>
            {% endif %}
        </div>
        
        <div class="flex items-center gap-2">
            <select class="bg-[var(--white_grey)] rounded-md px-2 py-1 text-sm" 
                    onchange="window.location.href='?page=1&items_per_page=' + this.value + '{% if search_query %}&q={{ search_query }}{% endif %}{% if filter_status %}&filter_status={{ filter_status }}{% endif %}'">
                <option value="6" {% if items_per_page == 6 %}selected{% endif %}>6</option>
                <option value="10" {% if items_per_page == 10 %}selected{% endif %}>10</option>
                <option value="20" {% if items_per_page == 20 %}selected{% endif %}>20</option>
            </select>
        </div>
    </div>
    {% endif %}
{% endif %}
