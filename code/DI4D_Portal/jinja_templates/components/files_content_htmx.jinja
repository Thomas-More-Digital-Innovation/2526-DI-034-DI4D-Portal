<div class="mt-4 flex items-center gap-3 text-black">
    {% if parent_folder_token %}
        <a href="#"
           class="btn_primary_blue"
           hx-get="{{ url('files') }}"
           hx-vals='{"folder": "{{ parent_folder_token }}"}'
           hx-target="#files-content"
           hx-swap="innerHTML"
           hx-push-url="true">Up</a>
    {% elif current_folder_token %}
        <a href="#"
           class="btn_primary_blue"
           hx-get="{{ url('files') }}"
           hx-target="#files-content"
           hx-swap="innerHTML"
           hx-push-url="true">Up</a>
    {% endif %}
    <p class="text-sm md:text-base">Current folder: {{ current_folder_name }}</p>
</div>

<input type="hidden" id="current-parent-folder-token" name="parent_folder_token" value="{{ current_folder_token or '' }}">

<form class="mt-4 flex flex-col gap-2 lg:flex-row lg:items-center"
      method="POST"
      hx-post="{{ url('files') }}"
      hx-target="#files-content"
      hx-swap="innerHTML">
    {{ csrf_input }}
    <input type="hidden" name="folder" value="{{ current_folder_token or '' }}">
    <input type="text"
           id="q"
           name="q"
           placeholder="Search..."
           value="{{ search_query }}"
           class="bg-[--white_grey] rounded-md w-full lg:max-w-md px-4 py-2"
           hx-trigger="keyup changed delay:300ms"
           hx-sync="closest form:abort">

    <select name="file_type"
            class="bg-[--white_grey] rounded-md px-4 py-2 lg:w-40"
            hx-trigger="change"
            hx-post="{{ url('files') }}"
            hx-target="#files-content"
            hx-sync="closest form:abort">
        <option value="all" {% if file_type == 'all' %}selected{% endif %}>All</option>
        <option value="pptx" {% if file_type == 'pptx' %}selected{% endif %}>PPTX</option>
        <option value="txt" {% if file_type == 'txt' %}selected{% endif %}>TXT</option>
        <option value="folder" {% if file_type == 'folder' %}selected{% endif %}>Folder</option>
    </select>
</form>

<div id="files-table" class="mt-4">
    {% include 'components/files_table_htmx.jinja' %}
</div>
